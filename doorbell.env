# Settings for doorbell.service, installed to /etc/doorbell.env by install.sh
# (SELinux blocks systemd from reading env files in /home). Edit here, redeploy.
# Local clips folder; also the fallback when the NAS is unavailable
OUT_DIR=/home/amol/projects/doorbell/clips
# Router USB drive (mounted by scripts/setup-nas.sh); clips move to NAS_DIR/frontdoor, NAS_DIR/patio.
# Leave empty to keep everything local.
NAS_DIR=/mnt/nas/doorbell
CLIP_SECONDS=30
RECORD_MOTION=1
RECORD_DING=1
# Local clips older than this many days are deleted daily by doorbell-cleanup.timer (NAS is not touched)
KEEP_DAYS=14
# 1 = verbose ring-client-api logging (push notification diagnostics)
DEBUG=0
